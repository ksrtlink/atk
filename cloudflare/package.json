{
  "name": "tinytrail",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && node scripts/check-config.mjs && wrangler deploy",
    "test": "node --experimental-sqlite scripts/test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "jose": "6.1.0",
    "jspdf": "4.2.1",
    "svg2pdf.js": "2.8.1"
  },
  "devDependencies": {
    "@zxing/library": "0.21.3",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "wrangler": "4.92.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
