{
  "name": "tinytrail",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && node scripts/check-config.mjs && wrangler deploy",
    "test": "node --experimental-sqlite scripts/test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:staging": "npm run build && node scripts/check-staging.mjs && wrangler deploy --config wrangler.staging.jsonc",
    "test:analytics:browser": "node tests/browser-analytics.mjs",
    "test:theme": "node tests/theme.mjs",
    "test:theme:browser": "node tests/browser-theme.mjs"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.15.0",
    "@phosphor-icons/react": "2.1.10",
    "fflate": "0.8.3",
    "ipaddr.js": "2.5.0",
    "jose": "6.1.0",
    "jspdf": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svg2pdf.js": "2.8.1"
  },
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1",
    "@zxing/library": "0.21.3",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "linkedom": "0.18.13",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "wrangler": "4.151.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
